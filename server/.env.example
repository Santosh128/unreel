PORT=3000
# 0.0.0.0 for local testing from a phone; 127.0.0.1 on a server behind nginx/Apache
HOST=0.0.0.0

# Local (MAMP) defaults; on the server use your MySQL host and a dedicated user
DB_HOST=127.0.0.1
DB_PORT=8889
DB_USER=root
DB_PASSWORD=root
DB_NAME=unreel

# Optional: comma-separated allowed web origins (unset = allow all)
# CORS_ORIGIN=https://unreel.example.com,http://localhost
